# VCS / editor
.git
.gitignore
.cursor
.vscode
.idea
*.code-workspace

# Dependencies and build output
node_modules
.next
out
dist
build
.vercel
.turbo
*.tsbuildinfo

# Secrets and local env (never bake into the image)
.env
.env.*
!.env.example
.env*.backup*

# Private / local-only trees
docs-private/
scripts-private/
project-archive/
backup/
backups/
**/*.dump
**/*.pem
**/*.backup
**/*.backup.*

# Tests, reports, logs
tests/
coverage/
.nyc_output/
playwright-report/
test-results/
.lighthouseci/
.email-test-output/
reports/
logs/
*.log
npm-debug.log*
dev.log

# Docs are not required to compile the image
*.md
AGENTS.md

# Docker metadata (already available to the daemon)
Dockerfile
.dockerignore
docker-compose.yml
