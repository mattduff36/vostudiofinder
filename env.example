# Voiceover Studio Finder environment template
# Copy to .env.local and replace placeholders. Never commit real secrets.
#
# Classification:
#   required     — needed for a working local/production app runtime
#   optional     — feature degrades or is skipped when unset
#   tooling      — scripts/admin integrations only, not the app runtime
#   test-only    — Jest/Playwright; never point at production
#   NEXT_PUBLIC_ — exposed to the browser; never put server secrets here
#
# Platform-injected (do not set in .env.local): NODE_ENV, VERCEL_*, NEXT_RUNTIME,
# GITHUB_RUN_NUMBER, NEXT_PUBLIC_GIT_COMMIT_DATE, NEXT_PUBLIC_BUILD_VERSION.

# -----------------------------------------------------------------------------
# Core / site
# -----------------------------------------------------------------------------
PORT=4000
NEXT_PUBLIC_BASE_URL="http://localhost:4000"
# Optional alias used by some email/cron paths if NEXT_PUBLIC_BASE_URL is unset.
NEXT_PUBLIC_SITE_URL="http://localhost:4000"
# Optional. Mapped into the client bundle by next.config.ts. Not read elsewhere.
CUSTOM_KEY=""

# -----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/vostudiofinder_dev"

# -----------------------------------------------------------------------------
# Auth (NextAuth v4)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="generate-a-32-byte-secret-and-replace-this"
NEXTAUTH_URL="http://localhost:4000"

# OAuth providers — required only for the matching sign-in method
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# -----------------------------------------------------------------------------
# Stripe (server-owned prices; never expose Price IDs as NEXT_PUBLIC_*)
# Use sk_test_/pk_test_ locally. Live keys belong only in production secrets.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
STRIPE_MEMBERSHIP_PRICE_ID_30_ONE_TIME="price_your-membership-price-id"
STRIPE_PREMIUM_SUBSCRIPTION_PRICE_ID_30="price_your-subscription-price-id"
STRIPE_5YEAR_MEMBERSHIP_PRICE_ID_100="price_your-5year-membership-price-id"
STRIPE_6MONTH_FEATURED_STUDIO_PRICE_ID="price_your-6month-featured-price-id"

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="VoiceoverStudioFinder <support@voiceoverstudiofinder.com>"
# Optional
RESEND_REPLY_TO_EMAIL="support@voiceoverstudiofinder.com"
# Optional. Booking/enquiry From address; falls back to booking-enquiry@...
RESEND_BOOKING_FROM_EMAIL="booking-enquiry@voiceoverstudiofinder.com"
RESEND_WEBHOOK_SECRET="whsec_your-resend-webhook-signing-secret"

# -----------------------------------------------------------------------------
# Maps
# -----------------------------------------------------------------------------
# Server geocoding. next.config.ts also copies this onto NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# -----------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
CRON_SECRET="replace-with-openssl-rand-hex-32"

# -----------------------------------------------------------------------------
# File upload (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# -----------------------------------------------------------------------------
# Redis cache (optional — search cache is skipped when REDIS_URL is unset)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
CACHE_PREFIX="vsf"

# -----------------------------------------------------------------------------
# Monitoring / Sentry admin sync (optional at app runtime)
# Webhook + admin/cron sync remain; @sentry/nextjs is not a runtime dependency.
# -----------------------------------------------------------------------------
SENTRY_WEBHOOK_SECRET="your-sentry-webhook-secret"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG_SLUG="your-sentry-org-slug"
SENTRY_PROJECT_SLUG="your-sentry-project-slug"

# -----------------------------------------------------------------------------
# Search Console tooling (optional — scripts/fetch-search-console-indexing.ts)
# -----------------------------------------------------------------------------
GSC_OAUTH_CLIENT_PATH="google-search-console-oauth.json"

# -----------------------------------------------------------------------------
# Neon admin tooling (optional — scripts/cleanup-neon-branches.ts only)
# -----------------------------------------------------------------------------
NEON_API_KEY="your-neon-api-key"
NEON_PROJECT_ID="your-neon-project-id"

# -----------------------------------------------------------------------------
# Test-only
# Isolated database for mutating Jest integration tests. Required by tests
# under tests/**/integration/. Do not point this at production or the shared
# development database.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/vostudiofinder_test"
